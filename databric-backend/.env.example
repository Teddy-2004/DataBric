# ── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,https://databric.app

# ── Africa's Talking (SMS OTP) ─────────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
AT_SENDER_ID=DataBric

# ── Firebase (Push Notifications) ─────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ── Relay cluster ──────────────────────────────────────────────
RELAY_SECRET_KEY=shared-secret-between-backend-and-relay-nodes
RELAY_NODES=nairobi:relay1.databric.app:8443,kigali:relay2.databric.app:8443

# ── Usage tracking ─────────────────────────────────────────────
USAGE_HEARTBEAT_INTERVAL=5
SESSION_WARNING_THRESHOLD=0.95
